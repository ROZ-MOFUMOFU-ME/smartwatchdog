{
  "name": "smartwatchdog",
  "version": "0.4.0",
  "description": "Seamlessly monitor and manage server uptime using Google Sheets and Cloudflare Workers for real-time performance insights.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --listEmittedFiles",
    "clean": "rm -rf dist",
    "deploy": "wrangler deploy",
    "start": "node dist/index.js",
    "start:ts": "ts-node src/index.ts",
    "test": "node_modules/.bin/jest --passWithNoTests",
    "test:coverage": "node_modules/.bin/jest --coverage",
    "lint": "eslint --ext .ts src",
    "lint:fix": "eslint --ext .ts src --fix",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "format:check": "prettier --ignore-path .gitignore --check \"**/*.+(js|ts|json)\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/ROZ-MOFUMOFU-ME/smartwatchdog.git"
  },
  "author": "Aoi Emerauda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ROZ-MOFUMOFU-ME/smartwatchdog/issues"
  },
  "homepage": "https://github.com/ROZ-MOFUMOFU-ME/smartwatchdog#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.4",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "^4.169.0"
  }
}
